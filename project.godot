; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be modified with a text editor.

config_version=5

[application]

config/name="Đạo Tàn: Vạn Kiếp"
config/description="2D Xianxia Sandbox RPG • Windows PC Native"
config/version="0.0.1"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

ContentRegistry="*res://scripts/core/content_registry.gd"
EventBus="*res://scripts/core/event_bus.gd"
GameClock="*res://scripts/core/game_clock.gd"
RNGService="*res://scripts/core/rng_service.gd"
SaveService="*res://scripts/persistence/save_service.gd"
GameSession="*res://scripts/core/game_session.gd"
MonthlySimulationService="*res://scripts/domain/monthly_simulation_service.gd"
SessionAuthority="*res://scripts/network/session_authority.gd"
ClockReplication="*res://scripts/network/clock_replication.gd"
CoopWorldSync="*res://scripts/network/coop_world_sync.gd"
AudioService="*res://scripts/core/audio_service.gd"
WorldRegistry="*res://scripts/world/world_registry.gd"
CourtManager="*res://scripts/politics/court_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

